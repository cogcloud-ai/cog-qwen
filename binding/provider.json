{
  "document_kind": "provider",
  "contract": "openteams/satisfier-binding [0.1-draft]",
  "provider": {
    "id": "openteams/cog-qwen",
    "version": "0.1.0"
  },
  "capability": "model-endpoint/openai-compatible",
  "compositions": [
    "model"
  ],
  "binding_interface": "bind",
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model_id": {
        "const": "qwen3-4b-q4_k_m"
      },
      "gateway_base_url": {
        "type": "string",
        "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}$"
      },
      "max_output_tokens": {
        "type": "integer",
        "minimum": 128,
        "maximum": 8192
      }
    },
    "required": [
      "model_id",
      "gateway_base_url",
      "max_output_tokens"
    ]
  },
  "model_requirement": null,
  "credential_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "api_key",
      "gateway_token"
    ],
    "properties": {
      "api_key": {
        "const": "env:COG_QWEN_BACKEND_TOKEN"
      },
      "gateway_token": {
        "const": "env:COG_QWEN_TOKEN"
      }
    }
  }
}
